#!/bin/sh
set -eu

# ProviderOS-branded tray entrypoint. The implementation remains in the
# historical file so existing scripts and installed launch agents can migrate
# without losing their service state.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd)
exec "$bin_dir/model-router-tray" "$@"
