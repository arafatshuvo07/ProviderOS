#!/bin/sh
set -eu

# ProviderOS is the public product name and primary command. The historical
# codex-router dispatcher remains a compatibility alias for existing scripts.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd)
exec "$bin_dir/provideros-dispatcher" "$@"
