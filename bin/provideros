#!/bin/sh
set -eu

# ProviderOS is the public product name and primary command. This thin shim
# keeps the packaged entrypoint relocatable while the dispatcher owns routing.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd)
exec "$bin_dir/provideros-dispatcher" "$@"
